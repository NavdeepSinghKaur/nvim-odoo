{
  "Odoo ACL: header + rows": {
    "prefix": "oacl",
    "description": "ir.model.access.csv (header + user/manager rows)",
    "body": [
      "id,name,model_id:id,group_id:id,perm_read,perm_write,perm_create,perm_unlink",
      "access_${1:my_thing}_user,${2:my.thing}.user,model_${1:my_thing},${3:base.group_user},1,1,1,0",
      "access_${1:my_thing}_manager,${2:my.thing}.manager,model_${1:my_thing},${4:base.group_system},1,1,1,1"
    ]
  },
  "Odoo ACL: row": {
    "prefix": "oaclrow",
    "description": "One ir.model.access.csv row",
    "body": [
      "access_${1:my_thing}_${2:user},${3:my.thing}.${2:user},model_${1:my_thing},${4:base.group_user},1,${5:1},${6:1},${7:0}"
    ]
  }
}
