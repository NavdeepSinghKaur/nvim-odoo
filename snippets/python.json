  "Odoo: wizard": {
    "prefix": "owizard",
    "description": "Wizard (TransientModel) with a confirm action",
    "body": [
      "from odoo import _, api, fields, models",
      "from odoo.exceptions import UserError",
      "",
      "",
      "class ${1:MyThingWizard}(models.TransientModel):",
      "    _name = \"${2:my.thing.wizard}\"",
      "    _description = \"${3:Thing wizard}\"",
      "",
      "    ${4:record_ids} = fields.Many2many(",
      "        comodel_name=\"${5:res.partner}\",",
      "        string=\"Records\",",
      "        default=lambda self: self.env.context.get(\"active_ids\"),",
      "    )",
      "",
      "    def action_confirm(self):",
      "        self.ensure_one()",
      "        $0",
      "        return {\"type\": \"ir.actions.act_window_close\"}"
    ]
  },
