    "description": "Computed field + its @api.depends method",
    "body": [
      "${1:total} = fields.${2:Float}(string=\"${3:Total}\", compute=\"_compute_${1:total}\", store=${4|True,False|})",
      "",
      "@api.depends(\"${5:line_ids.amount}\")",
      "def _compute_${1:total}(self):",
      "    for rec in self:",
      "        rec.${1:total} = ${6:sum(rec.line_ids.mapped(\"amount\"))}",
      "$0"
    ]
  },
