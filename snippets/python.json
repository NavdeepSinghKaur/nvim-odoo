  "Odoo: override create": {
    "prefix": "ocreate",
    "description": "Override create (Odoo 18: model_create_multi, vals_list)",
    "body": [
      "@api.model_create_multi",
      "def create(self, vals_list):",
      "    for vals in vals_list:",
      "        if not vals.get(\"name\"):",
      "            vals[\"name\"] = self.env[\"ir.sequence\"].next_by_code(\"${1:my.thing}\") or _(\"New\")",
      "    records = super().create(vals_list)",
      "    $0",
      "    return records"
    ]
  },
