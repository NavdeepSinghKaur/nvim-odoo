{
  "Odoo: new model": {
    "prefix": "omodel",
    "description": "New model (class with _name, _description, name, company, active)",
    "body": [
      "from odoo import _, api, fields, models",
      "from odoo.exceptions import UserError, ValidationError",
      "",
      "",
      "class ${1:MyThing}(models.Model):",
      "    _name = \"${2:my.thing}\"",
      "    _description = \"${3:Thing}\"",
      "    _inherit = [\"mail.thread\", \"mail.activity.mixin\"]  # chatter + activities (remove if not needed)",
      "    _order = \"${4:name}\"",
      "    _check_company_auto = True",
      "",
      "    name = fields.Char(string=\"Name\", required=True, tracking=True)",
      "    active = fields.Boolean(default=True)",
      "    company_id = fields.Many2one(",
      "        comodel_name=\"res.company\",",
      "        string=\"Company\",",
      "        required=True,",
      "        default=lambda self: self.env.company,",
      "        index=True,",
      "    )",
      "    $0"
    ]
  },
