  "Odoo: ondelete check": {
    "prefix": "ounlink",
    "description": "Block deletion (@api.ondelete, the Odoo 18 way)",
    "body": [
      "@api.ondelete(at_uninstall=False)",
      "def _unlink_except_${1:done}(self):",
      "    if any(rec.${2:state} == \"${3:done}\" for rec in self):",
      "        raise UserError(_(\"${4:You cannot delete a done record.}\"))",
      "$0"
    ]
  },
  "Odoo: override copy": {
    "prefix": "ocopy",
    "description": "Override copy_data (duplicate)",
    "body": [
      "def copy_data(self, default=None):",
      "    vals_list = super().copy_data(default=default)",
      "    for rec, vals in zip(self, vals_list):",
      "        vals[\"name\"] = _(\"%s (copy)\", rec.name)",
      "    return vals_list"
    ]
  },
